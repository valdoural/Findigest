{
  "name": "fin-digest",
  "version": "0.10.3",
  "description": "Финансовый дайджест — настольное приложение",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "prepare-digest": "node scripts/prepare-digest.js",
    "vendor": "node scripts/vendor.js",
    "smoke": "xvfb-run -a electron --no-sandbox scripts/smoke.js",
    "dist:win": "electron-builder --win nsis --x64",
    "test": "node test/compare-web.js",
    "release": "node scripts/release.js",
    "test:mail": "xvfb-run -a electron --no-sandbox test/mail-test.js",
    "test:mail-retry": "xvfb-run -a electron --no-sandbox test/mail-retry-test.js",
    "test:mail-journey": "xvfb-run -a -s \"-screen 0 1600x1000x24\" electron --no-sandbox test/mail-journey-test.js /tmp/fd-mj",
    "test:layout": "xvfb-run -a electron --no-sandbox test/layout-test.js /tmp/fd-layout none",
    "test:assistant": "xvfb-run -a electron --no-sandbox test/assistant-test.js /tmp/fd-assistant",
    "test:import": "xvfb-run -a electron --no-sandbox test/import-test.js /tmp/fd-import",
    "test:insights": "xvfb-run -a electron --no-sandbox test/insights-test.js /tmp/fd-insights",
    "test:logos": "xvfb-run -a electron --no-sandbox test/logos-test.js /tmp/fd-logos",
    "test:models": "xvfb-run -a electron --no-sandbox test/models-test.js /tmp/fd-models",
    "test:providers": "xvfb-run -a electron --no-sandbox test/providers-test.js",
    "test:ui": "xvfb-run -a -s \"-screen 0 1600x1000x24\" electron --no-sandbox test/ui-pass-test.js /tmp/fd-ui",
    "test:v09": "xvfb-run -a -s \"-screen 0 1600x1000x24\" electron --no-sandbox test/v09-test.js /tmp/fd-v09",
    "test:speech": "node test/speech-test.js",
    "test:zen": "node test/zen-rules-test.js",
    "test:updates": "xvfb-run -a -s \"-screen 0 1600x1000x24\" electron --no-sandbox test/updates-test.js /tmp/fd-upd"
  },
  "keywords": [],
  "author": "Vlad Nikolaev",
  "fdRelease": { "owner": "valdoural", "repo": "findigest" },
  "license": "UNLICENSED",
  "dependencies": {
    "imapflow": "^1.2.9",
    "mailparser": "^3.12.4",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@fontsource/geologica": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "hoodiecrow-imap": "^3.3.1",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^3.11.174",
    "resedit": "^2.0.3",
    "xlsx": "^0.18.5"
  },
  "productName": "FinDigest",
  "build": {
    "appId": "ru.nikolaev.findigest",
    "productName": "Финансовый дайджест",
    "executableName": "FinDigest",
    "copyright": "© Vlad Nikolaev",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!src/**/*.map"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Финансовый дайджест",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "unicode": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/license_ru.txt",
      "artifactName": "FinDigest-Setup-${version}.exe"
    },
    "publish": null
  }
}
